# Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
PORT=8787
# Claude model used for spine recognition
BOOKSHELF_MODEL=claude-opus-5
# Fallback model used only when the primary model declines the request
BOOKSHELF_FALLBACK_MODEL=claude-opus-4-8
