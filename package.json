{
  "name": "find-my-book",
  "private": true,
  "version": "0.2.0",
  "description": "책장 사진을 찍으면 책등 글자를 읽어 책 목록을 만들어 주는 앱 (오픈소스 OCR)",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-tesseract-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-tesseract-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --pretty",
    "fetch:langdata": "node scripts/fetch-langdata.mjs",
    "bench": "node bench/run.mjs",
    "bench:flow": "node bench/flow.mjs",
    "bench:read": "node bench/read.mjs",
    "bench:segment": "node bench/segment.mjs",
    "bench:crops": "node bench/crops.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.49.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
